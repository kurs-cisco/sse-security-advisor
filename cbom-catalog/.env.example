POSTGRES_DB=cbom_catalog
POSTGRES_USER=cbom
POSTGRES_PASSWORD=cbom_local_only
POSTGRES_PORT=55432
DATABASE_HOST=postgres
DATABASE_PORT=5432
CBOM_CORPUS_ROOT=../OneDrive_1_9-18-2026
CBOM_SOURCE_COLLECTION=sse-cboms
# CBOM_SOURCE_URI=s3://immutable-bucket/sse-cboms/2026-09-17
CBOM_STORE_RAW_JSON=true
CBOM_FORCE_REPROCESS=false
# Set true only when this directory is the complete authoritative view of the collection.
CBOM_AUTHORITATIVE_SNAPSHOT=true
CBOM_API_PAGE_SIZE=100
CBOM_API_ALLOW_RAW=false
API_PORT=8000
WEB_PORT=3000
PYTHON_IMAGE=python:3.12-slim
POSTGRES_IMAGE=postgres:16-alpine
CBOM_CATALOG_IMAGE=cbom-catalog:local
CBOM_AUTH_MODE=dev
CBOM_ALLOW_INSECURE_DEV_AUTH=true
# Cloud-only settings. Store secrets in AWS Secrets Manager; never commit them.
# CBOM_AUTH_MODE=alb-oidc
# CBOM_ALB_ARN=arn:aws-us-gov:elasticloadbalancing:us-gov-east-1:123456789012:loadbalancer/app/cbom-workbench/0123456789abcdef
# CBOM_OIDC_CLIENT_ID=replace-with-client-id
# AUTH_KEYCLOAK_SECRET=resolved-at-runtime-from-secrets-manager
# CBOM_API_AUTH_MODE=bearer
# CBOM_API_BEARER_TOKEN=at-least-32-random-characters
