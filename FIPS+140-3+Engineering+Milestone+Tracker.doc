<col style=3D"width: 192.0px;">
<col style=3D"width: 300.0px;">
<col style=3D"width: 300.0px;">
<col style=3D"width: 300.0px;">
<col style=3D"width: 300.0px;">
</colgroup>
<tbody>
<tr data-local-id=3D"f025206a83ba">
<th data-local-id=3D"64a54125a894" class=3D"confluenceTh">
<p local-id=3D"da4245b32c14">Module</p></th>
<th data-local-id=3D"ff7dd922a9b6" class=3D"confluenceTh">
<p local-id=3D"c53236831772">Certificate</p></th>
<th data-local-id=3D"2854277a59f0" class=3D"confluenceTh">
<p local-id=3D"bafcd72e26bc">Tested Version</p></th>
<th data-local-id=3D"5fedc23fd95a" class=3D"confluenceTh">
<p local-id=3D"4aba493b480a">Standard</p></th>
<th data-local-id=3D"5fa1f654d18b" class=3D"confluenceTh">
<p local-id=3D"358459bca5f7">Status</p></th>
<th data-local-id=3D"42caf8ea6c48" class=3D"confluenceTh">
<p local-id=3D"f63ded28e0a3">Sunset</p></th>
</tr>
<tr data-local-id=3D"e59093273a13">
<td data-highlight-colour=3D"#ffebe6" data-local-id=3D"86e018272ee3" class=
=3D"confluenceTd">
<p local-id=3D"16e1b9099912">OpenSSL FIPS Provider (legacy)</p></td>
<td data-highlight-colour=3D"#ffebe6" data-local-id=3D"da76b1b43141" class=
=3D"confluenceTd">
<p local-id=3D"967ca3134c8e">#4282</p></td>
<td data-highlight-colour=3D"#ffebe6" data-local-id=3D"b07794e5872e" class=
=3D"confluenceTd">
<p local-id=3D"00b446c51ab0">3.0.8, 3.0.9</p></td>
<td data-highlight-colour=3D"#ffebe6" data-local-id=3D"9f33b79a78f1" class=
=3D"confluenceTd">
<p local-id=3D"888a0635ddd1">FIPS 140-2</p></td>
<td data-highlight-colour=3D"#ffebe6" data-local-id=3D"a0f99ced665a" class=
=3D"confluenceTd">
<p local-id=3D"75953b776b43"></p></td>
